    "test": "node --test test/*.test.js",
    "qr": "node tools/qr/qr.mjs"
  },
  "dependencies": {
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "wrangler": "^4.155.0",
    "zxing-wasm": "3.1.6"
  }
