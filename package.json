{
  "name": "edge-vcard",
  "version": "0.1.0",
  "private": true,
  "description": "A digital business card on a Cloudflare Worker: vCard download, installable QR view, event notes and a contact-swap form.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
